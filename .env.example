# Reference only: the application does NOT automatically load this file.
# Mock / Replay require no API key. Set these in the backend process environment
# only when intentionally enabling paid OpenAI API experiments.
OPENAI_API_KEY=
LLM_MODEL=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

# Separate application gateway key; never reused as an OpenAI direct key.
# KuaiAPI runs use the bounded pilot config/runner, not general API mode.
KUAIAPI_API_KEY=

# Optional settings; blank means use the application default.
QUANTAGENT_DB_PATH=
BACKEND_URL=
